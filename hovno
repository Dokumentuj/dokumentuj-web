/* ===== WIZARD STYLY ===== */
.wizard-container {
    background: var(--white);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    margin: 20px auto;
    max-width: 900px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.wizard-container.hidden {
    display: none;
}

.wizard-header {
    background: linear-gradient(135deg, #0073e6 0%, #0056a6 100%);
    color: white;
    padding: 30px;
    text-align: center;
}

.wizard-header h2 {
    margin: 0 0 20px 0;
    font-size: 1.8em;
    font-weight: 600;
    color: white; /* Přidáno pro bílý nadpis */
}

.wizard-progress {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.progress-step {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    transition: all 0.3s ease;
    color: white;
}

.progress-step.active {
    background: white;
    color: var(--primary-color);
    transform: scale(1.1);
}

.progress-step.completed {
    background: rgba(255, 255, 255, 0.8);
    color: var(--primary-color);
}

.wizard-content {
    padding: 40px;
}

.wizard-step {
    display: none;
}

.wizard-step.active {
    display: block;
    animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.wizard-question {
    font-size: 1.5em;
    font-weight: 600;
    color: var(--primary-color);
    text-align: center;
    margin-bottom: 30px;
}

.wizard-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.wizard-option {
    background: white;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 25px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
}

.wizard-option:hover {
    border-color: var(--accent-color);
    background: #f8fbff;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,115,230,0.1);
}

.wizard-option.selected {
    border-color: #4CAF50;
    background-color: #f8fff8;
    transform: scale(1.02);
}

.option-icon {
    font-size: 24px;
    margin-bottom: 10px;
    display: block;
}

.wizard-option strong {
    display: block;
    font-size: 1.2em;
    color: var(--primary-color);
    margin-bottom: 8px;
}

.wizard-option p {
    color: var(--text-color);
    margin: 0;
    font-size: 0.95em;
    line-height: 1.4;
}

.wizard-buttons {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 30px;
}

.wizard-btn {
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 120px;
}

.wizard-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.wizard-btn.secondary {
    background: #f8f9fa;
    color: var(--text-color);
    border: 1px solid var(--border-color);
}

.wizard-btn.secondary:hover:not(:disabled) {
    background: #e9ecef;
}

.wizard-btn.primary {
    background: var(--accent-color);
    color: white;
}

.wizard-btn.primary:hover:not(:disabled) {
    background: var(--primary-color);
    transform: translateY(-1px);
}

.wizard-summary {
    background: #f0f8ff;
    border: 2px solid #4CAF50;
    border-radius: 10px;
    padding: 20px;
    margin: 20px 0;
}

.summary-card h4 {
    color: var(--primary-color);
    margin-bottom: 15px;
}

.summary-item {
    margin: 10px 0;
    padding: 8px 0;
    border-bottom: 1px solid #eee;
}

.summary-item:last-child {
    border-bottom: none;
}

.price-summary {
    font-size: 18px;
    color: #4CAF50;
    font-weight: bold;
}

.price {
    font-weight: bold;
    font-size: 24px;
}

/* ===== MOBILNÍ OPTIMALIZACE WIZARDU ===== */
@media (max-width: 768px) {
